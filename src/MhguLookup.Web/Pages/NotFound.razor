@page "/not-found"
@page "/{*Path}"
@inject NavigationManager Navigation

@*  An address no tab has (a mistyped or old link): go to the home tab, as the React app does. *@

@code {
    [Parameter] public string? Path { get; set; }

    protected override void OnInitialized() => Navigation.NavigateTo(Nav.Home, replace: true);
}
